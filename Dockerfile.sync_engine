# =============================================================================
# AI Memory Pipeline - Obsidian Sync Engine Container
# =============================================================================
# This container runs the Obsidian vault sync engine on the NAS.
# It watches an Obsidian vault directory for Markdown file changes
# (created, modified, deleted) and syncs to Qdrant + LM Studio.
# =============================================================================

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    inotify-tools \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install sync engine specific dependencies
RUN pip install --no-cache-dir \
    watchdog>=3.0 \
    qdrant-client>=1.7,<1.8 \
    sentence-transformers>=2.0 \
    requests>=2.28.0 \
    mmh3>=3.0.0 \
    numpy>=1.24.0

# Copy application code
COPY ai_memory_pipeline/ ./ai_memory_pipeline/

# Create necessary directories
RUN mkdir -p /app/data/vault /app/data/graph /app/logs && \
    useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app

USER appuser

# Health check (ping the sync engine status file)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD test -f /app/data/sync_engine.pid && kill -0 $(cat /app/data/sync_engine.pid) 2>/dev/null || exit 1

# Default command: run the sync engine
CMD ["python", "-m", "ai_memory_pipeline.obsidian.sync_engine"]
