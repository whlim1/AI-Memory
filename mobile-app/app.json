{
  "expo": {
    "name": "AI Memory",
    "slug": "ai-memory-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["android", "ios"],
    "android": {
      "package": "com.whlim1.aimemory",
      "permissions": ["INTERNET", "RECORD_AUDIO", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "ios": {
      "bundleIdentifier": "com.whlim1.aimemory",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Used for voice note capture."
      }
    },
    "extra": {
      "apiBaseUrl": "http://192.168.0.16:9091",
      "qdrantUrl": "http://192.168.0.16:6333",
      "lmStudioUrl": "http://192.168.0.19:1234"
    }
  }
}
