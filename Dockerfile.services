# =============================================================================
# AI Memory Pipeline - Service Containers (Development/Testing)
# =============================================================================
# Use these Dockerfiles for development or if you want to run services separately
# For production, use Dockerfile.pipeline instead
# =============================================================================

# =============================================================================
# Base service image - contains all pipeline code
# =============================================================================
FROM python:3.11-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY ai_memory_pipeline/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ai_memory_pipeline/ ./ai_memory_pipeline/
COPY services/ ./services/

USER appuser

# =============================================================================
# Deduplication Service
# =============================================================================
FROM base AS deduplication

EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

CMD ["python", "-m", "uvicorn", "services.deduplication_service:app", "--host", "0.0.0.0", "--port", "8001"]

# =============================================================================
# Chunking Service
# =============================================================================
FROM base AS chunking

EXPOSE 8002
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

CMD ["python", "-m", "uvicorn", "services.chunking_service:app", "--host", "0.0.0.0", "--port", "8002"]

# =============================================================================
# Embedding Service
# =============================================================================
FROM base AS embedding

EXPOSE 8003
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8003/health || exit 1

CMD ["python", "-m", "uvicorn", "services.embedding_service:app", "--host", "0.0.0.0", "--port", "8003"]

# =============================================================================
# Model Cache Service
# =============================================================================
FROM base AS model-cache

EXPOSE 8004
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8004/health || exit 1

CMD ["python", "-m", "uvicorn", "services.model_cache_service:app", "--host", "0.0.0.0", "--port", "8004"]

# =============================================================================
# API Gateway
# =============================================================================
FROM base AS gateway

RUN pip install --no-cache-dir fastapi uvicorn[standard]

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "services.gateway:app", "--host", "0.0.0.0", "--port", "8000"]
