# =============================================================================
# AI Memory Pipeline - Production Container
# =============================================================================
# This container runs all pipeline services on the NAS
# It handles document processing, chunking, embedding, deduplication
# =============================================================================

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional dependencies for pipeline services
RUN pip install --no-cache-dir \
    uvicorn[standard] \
    fastapi \
    python-multipart \
    pydantic==2.9.0

# Copy application code
COPY ai_memory_pipeline/ ./ai_memory_pipeline/
COPY services/ ./services/

# Create log directory
RUN mkdir -p /app/logs /shared_memory/me /shared_memory/wife /shared_memory/shared && \
    useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app /shared_memory

USER appuser

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command: Start the API gateway (runs all services)
CMD ["python", "-m", "uvicorn", "services.gateway:app", "--host", "0.0.0.0", "--port", "8000"]
