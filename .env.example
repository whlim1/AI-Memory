# AI-Memory Environment Configuration
# Copy this file to .env and fill in your Infisical secrets

# =============================================================================
# LLM Provider Configuration (Dynamic Model Selection)
# =============================================================================

# LM Studio endpoint - default for local inference
# Supports OpenAI-compatible API format
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# LiteLLM configuration (optional - for dynamic model selection via LiteLLM)
# Get your API key from your LiteLLM instance
LITELLM_API_KEY=

# Model Selection Strategy
# Options: "auto" (best-in-class based on task), "manual" (use DEFAULT_MODEL)
LLM_SELECTION_STRATEGY=auto

# Default models for each category (used when strategy=manual or fallback)
DEFAULT_CHAT_MODEL=lmstudio-qwen3-27b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text-v1.5
DEFAULT_REASONING_MODEL=deepseek-reasoner
DEFAULT_CODE_MODEL=codestral-latest

# AI Categorization (Phase 6)
# Model used for note categorization, entity extraction, and tag generation
AI_CATEGORIZATION_MODEL=local-model

# AI Categorization Cache TTL in seconds (default: 3600 = 1 hour)
AI_CATEGORIZATION_CACHE_TTL=3600

# =============================================================================
# Infisical Configuration (Secrets Management)
# =============================================================================

# Infisical API credentials (get from https://app.infisical.com/)
# For Docker-based Infisical on local network: http://192.168.0.16:8081
INFISICAL_API_KEY=your_infisical_api_key_here
INFISICAL_ENVIRONMENT=development
INFISICAL_PROJECT_ID=b245c33e-7702-475c-b4f4-dbb4741d21b1
INFISICAL_URL=http://192.168.0.16:8081

# =============================================================================
# Qdrant Configuration (Vector Database)
# =============================================================================

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=aimemory_docs

# =============================================================================
# Git Configuration (Version Control)
# =============================================================================

GIT_AUTHOR_NAME=AI-Memory Bot
GIT_AUTHOR_EMAIL=ai-memory@localhost.localdomain

# =============================================================================
# Logging Configuration
# =============================================================================

LOG_LEVEL=INFO
LOG_DIR=C:\docker\qdrant\logs
