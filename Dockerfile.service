# =============================================================================
# AI Memory Pipeline Service Container
# =============================================================================
# Build: docker build -f Dockerfile.service -t ai-memory-service .
# Usage: Base for all pipeline services (dedup, chunking, embedding, model-cache)
# =============================================================================

FROM python:3.11-slim

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first for caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY ai_memory_pipeline/ ./ai_memory_pipeline/
COPY services/ ./services/

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose service port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Default command (override in docker-compose)
CMD ["python", "-m", "uvicorn", "services.deduplication_service:app", "--host", "0.0.0.0", "--port", "8001"]
