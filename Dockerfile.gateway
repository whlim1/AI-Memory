# =============================================================================
# AI Memory Pipeline API Gateway
# =============================================================================
# Build: docker build -f Dockerfile.gateway -t ai-memory-gateway .
# Usage: Single entry point for all pipeline services
# =============================================================================

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt uvicorn fastapi

COPY ai_memory_pipeline/ ./ai_memory_pipeline/
COPY services/ ./services/

# Create gateway
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "services.gateway:app", "--host", "0.0.0.0", "--port", "8000"]
